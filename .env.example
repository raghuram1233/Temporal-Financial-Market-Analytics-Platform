# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env

# --- Database (required) --------------------------------------------------
DB_HOST=localhost
DB_NAME=temporal
DB_USER=postgres
DB_PORT=5432
# No default exists in code. The app refuses to start without this.
DB_PASS=

# --- Flask (required) -----------------------------------------------------
# Signs session cookies. Anyone who knows it can forge a login as any user.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Flask (optional) -----------------------------------------------------
FLASK_DEBUG=false
# Send session cookies over HTTPS only. Defaults to true unless FLASK_DEBUG.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=720
HOST=127.0.0.1
PORT=5000

# Comma-separated origins allowed to make credentialed cross-origin calls.
# Leave empty: the UI is served by this app, so nothing cross-origin needs it.
CORS_ORIGINS=

# --- Behaviour ------------------------------------------------------------
# Applies schema.sql on startup. Destructive: the script drops every table.
AUTO_INIT_DB=false
ENABLE_SCHEDULER=true
MAX_DEPOSIT=500000
MIN_PASSWORD_LENGTH=8
DB_POOL_MIN=1
DB_POOL_MAX=20

# --- Data ingestion -------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
INGESTION_MODE=realtime
INGESTION_INTERVAL=5
